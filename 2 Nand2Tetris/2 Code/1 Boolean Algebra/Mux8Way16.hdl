// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    // Yeah the logic is exactly the same as the previous one
    // We just went from 2 iteration check to three

    // First Round
    Mux(a=a[0], b=b[0], sel=sel[0], out=e10);
    Mux(a=c[0], b=d[0], sel=sel[0], out=e20);
    Mux(a=e[0], b=f[0], sel=sel[0], out=e30);
    Mux(a=g[0], b=h[0], sel=sel[0], out=e40);

    // Second Round
    Mux(a=e10, b=e20, sel=sel[1], out=r10);
    Mux(a=e30, b=e40, sel=sel[1], out=r20);

    // Third Round
    Mux(a=r10, b=r20, sel=sel[2], out=out[0]);

    // Repeat
    Mux(a=a[1], b=b[1], sel=sel[0], out=e11);
    Mux(a=c[1], b=d[1], sel=sel[0], out=e21);
    Mux(a=e[1], b=f[1], sel=sel[0], out=e31);
    Mux(a=g[1], b=h[1], sel=sel[0], out=e41);

    Mux(a=e11, b=e21, sel=sel[1], out=r11);
    Mux(a=e31, b=e41, sel=sel[1], out=r21);

    Mux(a=r11, b=r21, sel=sel[2], out=out[1]);


    Mux(a=a[2], b=b[2], sel=sel[0], out=e12);
    Mux(a=c[2], b=d[2], sel=sel[0], out=e22);
    Mux(a=e[2], b=f[2], sel=sel[0], out=e32);
    Mux(a=g[2], b=h[2], sel=sel[0], out=e42);

    Mux(a=e12, b=e22, sel=sel[1], out=r12);
    Mux(a=e32, b=e42, sel=sel[1], out=r22);

    Mux(a=r12, b=r22, sel=sel[2], out=out[2]);


    Mux(a=a[3], b=b[3], sel=sel[0], out=e13);
    Mux(a=c[3], b=d[3], sel=sel[0], out=e23);
    Mux(a=e[3], b=f[3], sel=sel[0], out=e33);
    Mux(a=g[3], b=h[3], sel=sel[0], out=e43);

    Mux(a=e13, b=e23, sel=sel[1], out=r13);
    Mux(a=e33, b=e43, sel=sel[1], out=r23);

    Mux(a=r13, b=r23, sel=sel[2], out=out[3]);


    Mux(a=a[4], b=b[4], sel=sel[0], out=e14);
    Mux(a=c[4], b=d[4], sel=sel[0], out=e24);
    Mux(a=e[4], b=f[4], sel=sel[0], out=e34);
    Mux(a=g[4], b=h[4], sel=sel[0], out=e44);

    Mux(a=e14, b=e24, sel=sel[1], out=r14);
    Mux(a=e34, b=e44, sel=sel[1], out=r24);

    Mux(a=r14, b=r24, sel=sel[2], out=out[4]);


    Mux(a=a[5], b=b[5], sel=sel[0], out=e15);
    Mux(a=c[5], b=d[5], sel=sel[0], out=e25);
    Mux(a=e[5], b=f[5], sel=sel[0], out=e35);
    Mux(a=g[5], b=h[5], sel=sel[0], out=e45);

    Mux(a=e15, b=e25, sel=sel[1], out=r15);
    Mux(a=e35, b=e45, sel=sel[1], out=r25);

    Mux(a=r15, b=r25, sel=sel[2], out=out[5]);


    Mux(a=a[6], b=b[6], sel=sel[0], out=e16);
    Mux(a=c[6], b=d[6], sel=sel[0], out=e26);
    Mux(a=e[6], b=f[6], sel=sel[0], out=e36);
    Mux(a=g[6], b=h[6], sel=sel[0], out=e46);

    Mux(a=e16, b=e26, sel=sel[1], out=r16);
    Mux(a=e36, b=e46, sel=sel[1], out=r26);

    Mux(a=r16, b=r26, sel=sel[2], out=out[6]);


    Mux(a=a[7], b=b[7], sel=sel[0], out=e17);
    Mux(a=c[7], b=d[7], sel=sel[0], out=e27);
    Mux(a=e[7], b=f[7], sel=sel[0], out=e37);
    Mux(a=g[7], b=h[7], sel=sel[0], out=e47);

    Mux(a=e17, b=e27, sel=sel[1], out=r17);
    Mux(a=e37, b=e47, sel=sel[1], out=r27);

    Mux(a=r17, b=r27, sel=sel[2], out=out[7]);


    Mux(a=a[8], b=b[8], sel=sel[0], out=e18);
    Mux(a=c[8], b=d[8], sel=sel[0], out=e28);
    Mux(a=e[8], b=f[8], sel=sel[0], out=e38);
    Mux(a=g[8], b=h[8], sel=sel[0], out=e48);

    Mux(a=e18, b=e28, sel=sel[1], out=r18);
    Mux(a=e38, b=e48, sel=sel[1], out=r28);

    Mux(a=r18, b=r28, sel=sel[2], out=out[8]);


    Mux(a=a[9], b=b[9], sel=sel[0], out=e19);
    Mux(a=c[9], b=d[9], sel=sel[0], out=e29);
    Mux(a=e[9], b=f[9], sel=sel[0], out=e39);
    Mux(a=g[9], b=h[9], sel=sel[0], out=e49);

    Mux(a=e19, b=e29, sel=sel[1], out=r19);
    Mux(a=e39, b=e49, sel=sel[1], out=r29);

    Mux(a=r19, b=r29, sel=sel[2], out=out[9]);


    Mux(a=a[10], b=b[10], sel=sel[0], out=e110);
    Mux(a=c[10], b=d[10], sel=sel[0], out=e210);
    Mux(a=e[10], b=f[10], sel=sel[0], out=e310);
    Mux(a=g[10], b=h[10], sel=sel[0], out=e410);

    Mux(a=e110, b=e210, sel=sel[1], out=r110);
    Mux(a=e310, b=e410, sel=sel[1], out=r210);

    Mux(a=r110, b=r210, sel=sel[2], out=out[10]);


    Mux(a=a[11], b=b[11], sel=sel[0], out=e111);
    Mux(a=c[11], b=d[11], sel=sel[0], out=e211);
    Mux(a=e[11], b=f[11], sel=sel[0], out=e311);
    Mux(a=g[11], b=h[11], sel=sel[0], out=e411);

    Mux(a=e111, b=e211, sel=sel[1], out=r111);
    Mux(a=e311, b=e411, sel=sel[1], out=r211);

    Mux(a=r111, b=r211, sel=sel[2], out=out[11]);


    Mux(a=a[12], b=b[12], sel=sel[0], out=e112);
    Mux(a=c[12], b=d[12], sel=sel[0], out=e212);
    Mux(a=e[12], b=f[12], sel=sel[0], out=e312);
    Mux(a=g[12], b=h[12], sel=sel[0], out=e412);

    Mux(a=e112, b=e212, sel=sel[1], out=r112);
    Mux(a=e312, b=e412, sel=sel[1], out=r212);

    Mux(a=r112, b=r212, sel=sel[2], out=out[12]);


    Mux(a=a[13], b=b[13], sel=sel[0], out=e113);
    Mux(a=c[13], b=d[13], sel=sel[0], out=e213);
    Mux(a=e[13], b=f[13], sel=sel[0], out=e313);
    Mux(a=g[13], b=h[13], sel=sel[0], out=e413);

    Mux(a=e113, b=e213, sel=sel[1], out=r113);
    Mux(a=e313, b=e413, sel=sel[1], out=r213);

    Mux(a=r113, b=r213, sel=sel[2], out=out[13]);


    Mux(a=a[14], b=b[14], sel=sel[0], out=e114);
    Mux(a=c[14], b=d[14], sel=sel[0], out=e214);
    Mux(a=e[14], b=f[14], sel=sel[0], out=e314);
    Mux(a=g[14], b=h[14], sel=sel[0], out=e414);

    Mux(a=e114, b=e214, sel=sel[1], out=r114);
    Mux(a=e314, b=e414, sel=sel[1], out=r214);

    Mux(a=r114, b=r214, sel=sel[2], out=out[14]);


    Mux(a=a[15], b=b[15], sel=sel[0], out=e115);
    Mux(a=c[15], b=d[15], sel=sel[0], out=e215);
    Mux(a=e[15], b=f[15], sel=sel[0], out=e315);
    Mux(a=g[15], b=h[15], sel=sel[0], out=e415);

    Mux(a=e115, b=e215, sel=sel[1], out=r115);
    Mux(a=e315, b=e415, sel=sel[1], out=r215);

    Mux(a=r115, b=r215, sel=sel[2], out=out[15]);
}