// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    // What the chunk man
    // I think the logic is still the same for a[0], b[0], and sel[0]
    // And then the logic repeats itself with c[0], d[0], and sel[1]? Wait no
    // Because sel[1] and sel[0] influences c and d, while sel[0] influencs a and b
    // Wait I still need an Or at the end because we still used mux on a & b, c & d...

    // First check if code is in a or b, c or d.
    Mux(a=a[0], b=b[0], sel=sel[0], out=e10); 
    Mux(a=c[0], b=d[0], sel=sel[0], out=e20);

    // Then check the left over 2 places
    Mux(a=e10, b=e20, sel=sel[1], out=out[0]);

    //Repeat

    Mux(a=a[1], b=b[1], sel=sel[0], out=e11); 
    Mux(a=c[1], b=d[1], sel=sel[0], out=e21);
    Mux(a=e11, b=e21, sel=sel[1], out=out[1]);

    Mux(a=a[2], b=b[2], sel=sel[0], out=e12); 
    Mux(a=c[2], b=d[2], sel=sel[0], out=e22);
    Mux(a=e12, b=e22, sel=sel[1], out=out[2]);

    Mux(a=a[3], b=b[3], sel=sel[0], out=e13); 
    Mux(a=c[3], b=d[3], sel=sel[0], out=e23);
    Mux(a=e13, b=e23, sel=sel[1], out=out[3]);

    Mux(a=a[4], b=b[4], sel=sel[0], out=e14); 
    Mux(a=c[4], b=d[4], sel=sel[0], out=e24);
    Mux(a=e14, b=e24, sel=sel[1], out=out[4]);

    Mux(a=a[5], b=b[5], sel=sel[0], out=e15); 
    Mux(a=c[5], b=d[5], sel=sel[0], out=e25);
    Mux(a=e15, b=e25, sel=sel[1], out=out[5]);

    Mux(a=a[6], b=b[6], sel=sel[0], out=e16); 
    Mux(a=c[6], b=d[6], sel=sel[0], out=e26);
    Mux(a=e16, b=e26, sel=sel[1], out=out[6]);

    Mux(a=a[7], b=b[7], sel=sel[0], out=e17); 
    Mux(a=c[7], b=d[7], sel=sel[0], out=e27);
    Mux(a=e17, b=e27, sel=sel[1], out=out[7]);

    Mux(a=a[8], b=b[8], sel=sel[0], out=e18); 
    Mux(a=c[8], b=d[8], sel=sel[0], out=e28);
    Mux(a=e18, b=e28, sel=sel[1], out=out[8]);

    Mux(a=a[9], b=b[9], sel=sel[0], out=e19); 
    Mux(a=c[9], b=d[9], sel=sel[0], out=e29);
    Mux(a=e19, b=e29, sel=sel[1], out=out[9]);

    Mux(a=a[10], b=b[10], sel=sel[0], out=e110); 
    Mux(a=c[10], b=d[10], sel=sel[0], out=e210);
    Mux(a=e110, b=e210, sel=sel[1], out=out[10]);

    Mux(a=a[11], b=b[11], sel=sel[0], out=e111); 
    Mux(a=c[11], b=d[11], sel=sel[0], out=e211);
    Mux(a=e111, b=e211, sel=sel[1], out=out[11]);

    Mux(a=a[12], b=b[12], sel=sel[0], out=e112); 
    Mux(a=c[12], b=d[12], sel=sel[0], out=e212);
    Mux(a=e112, b=e212, sel=sel[1], out=out[12]);

    Mux(a=a[13], b=b[13], sel=sel[0], out=e113); 
    Mux(a=c[13], b=d[13], sel=sel[0], out=e213);
    Mux(a=e113, b=e213, sel=sel[1], out=out[13]);

    Mux(a=a[14], b=b[14], sel=sel[0], out=e114); 
    Mux(a=c[14], b=d[14], sel=sel[0], out=e214);
    Mux(a=e114, b=e214, sel=sel[1], out=out[14]);

    Mux(a=a[15], b=b[15], sel=sel[0], out=e115); 
    Mux(a=c[15], b=d[15], sel=sel[0], out=e215);
    Mux(a=e115, b=e215, sel=sel[1], out=out[15]);
}