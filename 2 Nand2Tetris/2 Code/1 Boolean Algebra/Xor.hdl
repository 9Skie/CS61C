// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Not(in=b, out=nb);
    Not(in=a, out=na);
    And(a=a, b=nb , out=w1);
    And(a=na, b=b , out=w2);
    Or(a=w1, b=w2, out=out);
    // So, I thought the logic looks similar to Or
    // Except one of the inputs is reversed for the And Gate
    // Also the sentence above gave it away too much for this one haha
}