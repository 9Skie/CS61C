// File name: projects/1/DMux.hdl
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Not(in=sel, out=nsel);
    And(a=in, b=nsel, out=a);
    And(a=sel, b=in, out=b);
    // The logic for in and sel to a is the same as the Mux!
    // If in=1 and sel=0, it should be 1, in all other cases it should be 0
    // Then we just reverse that logic for b
}