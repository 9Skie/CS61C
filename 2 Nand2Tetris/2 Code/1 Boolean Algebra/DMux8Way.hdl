// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    // Wait! Can I use a repeteition of DMux to do this?
    // With 1 DMux, I can broadcast into 2 channels, with 2 Demux I can broadcast into 4...
    // This is also a way to solve it, just feels a bit cheesy.
    DMux(in=in, sel=sel[2], a=up0, b=down0);
    DMux(in=up0, sel=sel[1], a=up1up0, b=down1up0);
    DMux(in=up1up0, sel=sel[0], a=a, b=b);

    DMux(in=down1up0, sel=sel[0], a=c, b=d);
    DMux(in=down0, sel=sel[1], a=up1down0, b=down1down0);
    DMux(in=up1down0, sel=sel[0], a=e, b=f);
    DMux(in=down1down0, sel=sel[0], a=g, b=h);
}