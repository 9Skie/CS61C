// File name: projects/2/Inc16.hdl
/**
 * 16-bit incrementer:
 * out = in + 1
 */
CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
    // It just adds 1???
    // Add16(a=in, b=true, out=out);
    // Wait no that makes everything true
    Add16(a=in, b[1..15]=false, b[0]=true, out=out); 
    // Ok dude I didn't know you could do that had to search it up
}