// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    // Lol it's like combining part of the ALU with the registor
    Mux16(a=in, b=false, sel=reset, out=rin);
    Register(in=rin, load=load, out=lrin);
    Add16(a=lrin, b[1..15]=false, b[0]=inc, out=out);
}